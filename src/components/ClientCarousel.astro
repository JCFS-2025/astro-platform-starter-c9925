---
import { clientes } from '../data/clientes';
// A lista é duplicada para que a animação em loop seja contínua.
const itens = [...clientes, ...clientes];
---

<div
    class="marquee relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]"
    aria-label="Clientes que utilizam o Axia Chat"
>
    <ul class="marquee-track flex w-max gap-4 py-2">
        {
            itens.map((c, i) => (
                <li
                    class="flex h-20 min-w-52 items-center justify-center rounded-xl border border-slate-200 bg-white px-6 shadow-sm"
                    aria-hidden={i >= clientes.length ? 'true' : undefined}
                >
                    {c.logo ? (
                        <img src={c.logo} alt={c.nome} loading="lazy" class="max-h-12 w-auto object-contain grayscale transition hover:grayscale-0" />
                    ) : (
                        <span class="text-center">
                            <span class="block text-sm font-semibold text-navy-900">{c.nome}</span>
                            {c.segmento && <span class="text-xs text-slate-500">{c.segmento}</span>}
                        </span>
                    )}
                </li>
            ))
        }
    </ul>
</div>
