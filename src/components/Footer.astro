---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, linkWhatsApp } from '../data/site';
const ano = new Date().getFullYear();
---

<footer class="bg-navy-950 text-slate-400">
    <div class="container-site grid gap-10 py-14 md:grid-cols-4">
        <div class="md:col-span-2">
            <Logo variant="light" />
            <p class="mt-4 max-w-md text-sm leading-relaxed">
                Soluções em atendimento digital, segurança de internet e certificação digital para empresas e profissionais. Consultoria,
                implantação e suporte próximos, do primeiro contato ao pós-venda.
            </p>
        </div>

        <div>
            <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Soluções</h2>
            <ul class="mt-4 space-y-2 text-sm">
                <li><a href="/#chat" class="hover:text-white">Axia Chat — Atendimento multicanal</a></li>
                <li><a href="/#dns" class="hover:text-white">Axia DNS — Filtro e segurança</a></li>
                <li><a href="/#certificado" class="hover:text-white">Axia ID — Certificado digital</a></li>
            </ul>
        </div>

        <div>
            <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Contato</h2>
            <ul class="mt-4 space-y-3 text-sm">
                <li>
                    <a href={linkWhatsApp()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white">
                        <Icon name="phone" class="size-4" />
                        {site.telefoneExibicao}
                    </a>
                </li>
                <li>
                    <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-white">
                        <Icon name="mail" class="size-4" />
                        {site.email}
                    </a>
                </li>
                <li class="inline-flex items-center gap-2"><Icon name="pin" class="size-4" />{site.cidade}</li>
            </ul>
        </div>
    </div>
    <div class="border-t border-white/10">
        <div class="container-site flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
            <p>© {ano} {site.nome}. Todos os direitos reservados.</p>
            <p>Axia Chat · Axia DNS · Axia ID</p>
        </div>
    </div>
</footer>
