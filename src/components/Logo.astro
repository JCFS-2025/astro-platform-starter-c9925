---
// Logo oficial da Axia Soluções. Os arquivos-fonte ficam em /public:
// logo.svg (fundo claro), logo-branco.svg (fundo escuro) e logo-simbolo.svg (só o símbolo).
import logoEscuro from '../../public/logo.svg?raw';
import logoBranco from '../../public/logo-branco.svg?raw';

interface Props {
    variant?: 'light' | 'dark';
    class?: string;
}
const { variant = 'dark', class: className = 'h-10 w-auto' } = Astro.props;
// Cada cópia do logo na página recebe IDs próprios: se um degradê com o mesmo ID estiver
// num elemento escondido (ex.: logo do cabeçalho ao rolar), as outras cópias perdem a cor.
const sufixo = Math.random().toString(36).slice(2, 8);
const svg = (variant === 'light' ? logoBranco : logoEscuro)
    .replace(/id="([^"]+)"/g, `id="$1-${sufixo}"`)
    .replace(/url\(#([^)]+)\)/g, `url(#$1-${sufixo})`)
    .replace('<svg ', `<svg class="${className}" `);
---

<Fragment set:html={svg} />
