---
// Logo oficial da Axia Soluções. Os arquivos-fonte ficam em /public:
// logo.svg (fundo claro), logo-branco.svg (fundo escuro) e logo-simbolo.svg (só o símbolo).
import logoEscuro from '../../public/logo.svg?raw';
import logoBranco from '../../public/logo-branco.svg?raw';

interface Props {
    variant?: 'light' | 'dark';
    class?: string;
}
const { variant = 'dark', class: className = 'h-10 w-auto' } = Astro.props;
const svg = (variant === 'light' ? logoBranco : logoEscuro).replace('<svg ', `<svg class="${className}" `);
---

<Fragment set:html={svg} />
