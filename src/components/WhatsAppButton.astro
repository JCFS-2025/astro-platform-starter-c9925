---
import WhatsAppIcon from './WhatsAppIcon.astro';
import Icon from './Icon.astro';
import { linkWhatsApp as montarLink } from '../lib/settings';

const config = Astro.locals.settings;
const linkWhatsApp = (mensagem?: string) => montarLink(config, mensagem);
---

<div class="fixed right-4 bottom-4 z-50 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6">
    <div
        class="relative hidden max-w-[16rem] rounded-2xl rounded-br-sm bg-white p-4 pr-9 text-sm text-slate-700 shadow-2xl ring-1 ring-slate-200"
        role="status"
        data-wa-bubble
        data-atraso={config.balaoAtivo ? config.balaoAtraso : -1}
    >
        <button
            type="button"
            class="absolute top-2 right-2 inline-flex size-6 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            aria-label="Fechar mensagem"
            data-wa-close
        >
            <Icon name="close" class="size-4" />
        </button>
        <p class="font-semibold text-navy-900">{config.balaoTitulo}</p>
        <p class="mt-1">{config.balaoTexto}</p>
    </div>

    <a
        href={linkWhatsApp()}
        target="_blank"
        rel="noopener"
        class="wa-pulse inline-flex size-16 items-center justify-center rounded-full bg-whatsapp text-white shadow-xl transition hover:scale-105 hover:bg-whatsapp-dark"
        aria-label="Chamar a Axia Soluções no WhatsApp"
    >
        <WhatsAppIcon class="size-9" />
    </a>
</div>

<script>
    const bubble = document.querySelector<HTMLElement>('[data-wa-bubble]')!;
    const fechar = document.querySelector<HTMLButtonElement>('[data-wa-close]')!;
    const CHAVE = 'axia-wa-bubble-fechado';

    let fechado = false;
    try {
        fechado = sessionStorage.getItem(CHAVE) === '1';
    } catch {}

    const atraso = Number(bubble.dataset.atraso);
    if (!fechado && atraso >= 0) {
        setTimeout(() => bubble.classList.remove('hidden'), atraso * 1000);
    }

    fechar.addEventListener('click', () => {
        bubble.classList.add('hidden');
        try {
            sessionStorage.setItem(CHAVE, '1');
        } catch {}
    });
</script>
