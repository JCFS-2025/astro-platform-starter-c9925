---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada | Axia Soluções">
    <section class="flex min-h-[70vh] items-center bg-slate-50 pt-24">
        <div class="container-site text-center">
            <p class="text-6xl font-extrabold text-brand-500">404</p>
            <h1 class="mt-4 text-3xl font-bold">Página não encontrada</h1>
            <p class="mt-3 text-slate-600">O endereço que você procurou não existe ou foi alterado.</p>
            <a href="/" class="btn-primary mt-8">Voltar para o início</a>
        </div>
    </section>
</Layout>

<script>
    document.body.setAttribute('data-solid-header', '');
    window.dispatchEvent(new Event('scroll'));
</script>
